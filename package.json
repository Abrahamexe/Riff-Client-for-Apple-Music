{
  "name": "am-client",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Riff Client — Windows için Apple Music masaüstü istemcisi",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build && node scripts/verify-prod-bundle.mjs && npm run notices",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "node scripts/e2e.mjs",
    "evs:verify": "node scripts/evs-sign-dev.mjs --verify",
    "evs:sign-dev": "node scripts/evs-sign-dev.mjs",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win",
    "dist:release": "node scripts/release-build.mjs",
    "dist:dev": "npm run build:dev && electron-builder --win",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run depcruise && npm test && npm run scan:secrets",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "icons": "electron scripts/make-icons.cjs",
    "build:dev": "npm run typecheck && electron-vite build --mode devbuild && npm run notices",
    "preview:dev": "electron-vite preview --mode devbuild",
    "pack:dev": "npm run build:dev && electron-builder --dir",
    "verify:bundle": "node scripts/verify-prod-bundle.mjs",
    "notices": "node scripts/third-party-notices.mjs",
    "scan:plaintext": "electron-vite preview --mode devbuild -- --scan-plaintext"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.2",
    "dependency-cruiser": "^18.4.0",
    "electron": "https://github.com/castlabs/electron-releases/archive/refs/tags/v44.5.1%2Bwvcus.tar.gz",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "msw": "^3.0.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.56.0",
    "motion": "^14.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "author": "Riff Client",
  "overrides": {
    "global-agent": "^4.1.3"
  }
}
